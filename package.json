{
  "name": "sis2-playwright-toolshop",
  "version": "1.0.0",
  "description": "SIS 2 — Playwright test automation for practicesoftwaretesting.com (Toolshop)",
  "private": true,
  "scripts": {
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:ui": "playwright test --ui",
    "test:bugs": "LEGACY_API=1 BASE_URL=https://with-bugs.practicesoftwaretesting.com API_URL=https://api-with-bugs.practicesoftwaretesting.com playwright test",
    "report": "playwright show-report",
    "typecheck": "tsc --noEmit"
  },
  "license": "MIT",
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2"
  }
}
